---
/**
 * Elemento gráfico abstrato (rede de nós + linha costeira estilizada), estático
 * e decorativo. Usa as cores institucionais em baixa opacidade.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={`decor ${className}`.trim()}
  viewBox="0 0 640 480"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMaxYMid slice"
>
  <defs>
    <pattern id="dots" width="24" height="24" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.2" fill="var(--navy)" opacity="0.14"></circle>
    </pattern>
  </defs>
  <rect width="640" height="480" fill="url(#dots)"></rect>
  <path
    d="M-10 372c60-28 96-72 152-70 48 2 80 44 128 40 62-6 92-64 150-72 62-8 108 30 160 20l70-20"
    fill="none"
    stroke="var(--teal)"
    stroke-width="1.5"
    opacity="0.45"
  ></path>
  <path
    d="M-10 404c66-20 104-56 158-54 50 2 84 40 132 36 60-6 90-56 148-64 60-8 104 26 156 16l66-18"
    fill="none"
    stroke="var(--teal)"
    stroke-width="1"
    opacity="0.25"
  ></path>
  <g stroke="var(--navy)" stroke-width="1" opacity="0.35" fill="none">
    <path d="M120 110 220 80 300 150 420 120 520 180 600 140"></path>
    <path d="M220 80 300 40 420 120"></path>
    <path d="M300 150 360 230 420 120"></path>
    <path d="M520 180 470 260 360 230"></path>
    <path d="M120 110 180 210 300 150"></path>
  </g>
  <g fill="var(--navy)">
    <circle cx="120" cy="110" r="4" opacity="0.7"></circle>
    <circle cx="220" cy="80" r="3.5" opacity="0.7"></circle>
    <circle cx="300" cy="40" r="3" opacity="0.5"></circle>
    <circle cx="300" cy="150" r="5" opacity="0.8"></circle>
    <circle cx="420" cy="120" r="4" opacity="0.7"></circle>
    <circle cx="520" cy="180" r="3.5" opacity="0.7"></circle>
    <circle cx="600" cy="140" r="3" opacity="0.5"></circle>
    <circle cx="360" cy="230" r="4" opacity="0.7"></circle>
    <circle cx="470" cy="260" r="3" opacity="0.5"></circle>
    <circle cx="180" cy="210" r="3" opacity="0.5"></circle>
  </g>
  <g fill="var(--ochre)">
    <circle cx="300" cy="150" r="9" opacity="0.18"></circle>
    <circle cx="420" cy="120" r="7" opacity="0.15"></circle>
  </g>
</svg>

<style>
  .decor {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
