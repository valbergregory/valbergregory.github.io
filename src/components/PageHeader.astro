---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';
import type { Lang } from '@/i18n/routes';

interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  eyebrow?: string;
  crumbs?: Crumb[];
}
const { lang, title, lead, eyebrow, crumbs } = Astro.props;
---

<header class="page-header">
  <div class="container">
    {crumbs && crumbs.length > 0 && <Breadcrumbs {lang} items={crumbs} />}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    padding-block: var(--space-7) var(--space-6);
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(60rem 20rem at 100% -10%, var(--navy-soft) 0%, transparent 60%), var(--bg);
  }
  .page-header h1 {
    max-width: 26ch;
  }
  .page-header .lead {
    margin-bottom: 0;
  }
  .page-header .lead + :global(*) {
    margin-top: var(--space-4);
  }
</style>
