---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ResearchCard from '@/components/ResearchCard.astro';
import { alternates, route, type Lang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { breadcrumbJsonLd } from '@/lib/jsonld';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';

const entry = (await getCollection('pages')).find(
  (e) => e.data.key === 'teaching' && e.data.lang === lang,
);
if (!entry) throw new Error(`Conteúdo "teaching" não encontrado para ${lang}`);
const { Content } = await render(entry);

// Pesquisas que nasceram da docência (turismo e pesca).
const fromTeaching = (await getCollection('research')).filter((r) =>
  ['tourism-gravity-brazil', 'marine-heatwaves-fishing-effort', 'fishing-closures-brazil'].includes(
    r.data.slug,
  ),
);

const crumbs = [
  { label: t('nav.home'), href: route('home', lang) },
  { label: t('teaching.title') },
];
---

<BaseLayout
  {lang}
  title={entry.data.title}
  description={entry.data.description}
  current="teaching"
  alternates={alternates('teaching')}
  jsonLd={[
    breadcrumbJsonLd([
      { name: t('nav.home'), path: route('home', lang) },
      { name: t('teaching.title'), path: route('teaching', lang) },
    ]),
  ]}
>
  <PageHeader
    {lang}
    title={entry.data.title}
    lead={
      en
        ? 'Teaching as part of building the research agenda — and the way research and outreach return to the classroom.'
        : 'A docência como parte da construção da agenda de pesquisa — e o caminho de volta da pesquisa e da extensão para a sala de aula.'
    }
    {crumbs}
  />

  <div class="container page-body">
    <div class="markdown prose">
      <Content />
    </div>
  </div>

  <section class="section born" aria-labelledby="born-title">
    <div class="container">
      <div class="section-head">
        <h2 id="born-title">
          {en
            ? 'Research that grew out of the classroom'
            : 'Pesquisas que nasceram da sala de aula'}
        </h2>
      </div>
      <div class="grid grid-3">
        {fromTeaching.map((project) => (
          <ResearchCard {project} {lang} compact />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-body {
    padding-block: var(--space-7);
  }
  .markdown :global(h2) {
    font-size: var(--text-xl);
    margin-top: var(--space-6);
  }
  .markdown :global(h2:first-child) {
    margin-top: 0;
  }
  .markdown :global(li) {
    margin-bottom: var(--space-2);
  }
  .born {
    border-top: 1px solid var(--border);
    background: var(--bg-muted);
    padding-top: var(--space-7);
  }
</style>
