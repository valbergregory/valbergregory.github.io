---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ResearchCard from '@/components/ResearchCard.astro';
import { alternates, route, type Lang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { breadcrumbJsonLd } from '@/lib/jsonld';
import mosaic from '@/assets/valber-mosaico.webp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';

const entry = (await getCollection('pages')).find(
  (e) => e.data.key === 'teaching' && e.data.lang === lang,
);
if (!entry) throw new Error(`Conteúdo "teaching" não encontrado para ${lang}`);
const { Content } = await render(entry);

// Pesquisas que nasceram da docência (turismo e pesca).
const fromTeaching = (await getCollection('research')).filter((r) =>
  ['tourism-gravity-brazil', 'marine-heatwaves-fishing-effort', 'fishing-closures-brazil'].includes(
    r.data.slug,
  ),
);

const mosaicAlt = en
  ? 'Mosaic of four photographs: Valber with two people holding the book Desenvolvimento e Economia Regional; a portrait in a suit and tie; speaking into a microphone at a presentation table; and with two people at an event in February 2012.'
  : 'Mosaico de quatro fotografias: Valber com duas pessoas segurando o livro Desenvolvimento e Economia Regional; retrato de terno e gravata; falando ao microfone em uma mesa de apresentação; e com duas pessoas em um evento em fevereiro de 2012.';

const crumbs = [
  { label: t('nav.home'), href: route('home', lang) },
  { label: t('teaching.title') },
];
---

<BaseLayout
  {lang}
  title={entry.data.title}
  description={entry.data.description}
  current="teaching"
  alternates={alternates('teaching')}
  jsonLd={[
    breadcrumbJsonLd([
      { name: t('nav.home'), path: route('home', lang) },
      { name: t('teaching.title'), path: route('teaching', lang) },
    ]),
  ]}
>
  <PageHeader
    {lang}
    title={entry.data.title}
    lead={
      en
        ? 'Teaching as part of building the research agenda — and the way research and outreach return to the classroom.'
        : 'A docência como parte da construção da agenda de pesquisa — e o caminho de volta da pesquisa e da extensão para a sala de aula.'
    }
    {crumbs}
  />

  <div class="container teaching-layout">
    <div class="markdown prose">
      <Content />
    </div>
    <aside class="teaching-side">
      <figure class="teaching-photo">
        <Image
          src={mosaic}
          alt={mosaicAlt}
          width={360}
          height={450}
          widths={[280, 360, 560, 720]}
          sizes="(max-width: 56rem) 70vw, 360px"
          format="webp"
        />
        <figcaption class="small muted">
          {en
            ? 'Classroom, events and publications along the way.'
            : 'Sala de aula, eventos e publicações ao longo do caminho.'}
        </figcaption>
      </figure>
    </aside>
  </div>

  <section class="section born" aria-labelledby="born-title">
    <div class="container">
      <div class="section-head">
        <h2 id="born-title">
          {en
            ? 'Research that grew out of the classroom'
            : 'Pesquisas que nasceram da sala de aula'}
        </h2>
      </div>
      <div class="grid grid-3">
        {fromTeaching.map((project) => (
          <ResearchCard {project} {lang} compact />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .teaching-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--space-7);
    padding-block: var(--space-7);
    align-items: start;
  }
  .teaching-side {
    position: sticky;
    top: calc(var(--header-h) + var(--space-4));
  }
  .teaching-photo {
    margin: 0;
  }
  .teaching-photo :global(img) {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    width: 100%;
    height: auto;
  }
  .teaching-photo figcaption {
    margin-top: var(--space-2);
  }
  .markdown :global(h2) {
    font-size: var(--text-xl);
    margin-top: var(--space-6);
  }
  .markdown :global(h2:first-child) {
    margin-top: 0;
  }
  .markdown :global(li) {
    margin-bottom: var(--space-2);
  }
  .born {
    border-top: 1px solid var(--border);
    background: var(--bg-muted);
    padding-top: var(--space-7);
  }
  @media (max-width: 56rem) {
    .teaching-layout {
      grid-template-columns: 1fr;
    }
    .teaching-side {
      position: static;
      order: -1;
    }
    .teaching-photo {
      width: min(70%, 20rem);
      margin-inline: auto;
    }
  }
</style>
