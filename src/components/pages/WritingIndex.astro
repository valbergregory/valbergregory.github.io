---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import { alternates, route, type Lang } from '@/i18n/routes';
import { useTranslations, type UiKey } from '@/i18n/ui';
import { formatDate, getGithubProjects, getProfile, getTaxonomies } from '@/lib/data';
import { breadcrumbJsonLd } from '@/lib/jsonld';
import { getPosts, postDateIso, postSlug } from '@/lib/writing';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';
const profile = getProfile();
const tax = getTaxonomies();

const posts = await getPosts(lang);
const research = await getCollection('research');
const titleOf = (slug?: string) => research.find((r) => r.data.slug === slug)?.data.title;
const catKey = (c: string) => `category.${c}` as UiKey;
const categoriesUsed = tax.updateCategories.filter((c) => posts.some((p) => p.data.category === c));

// Atividade automática dos repositórios (metadados públicos; não são textos editoriais).
const github = getGithubProjects();
const byRepo = new Map(
  research.filter((r) => r.data.repository).map((r) => [r.data.repository!.toLowerCase(), r]),
);
type Event = {
  date: string;
  kind: 'push' | 'release';
  repo: string;
  url: string;
  title: string;
  slug: string;
  tag?: string;
};
const events: Event[] = [];
for (const repo of github.repositories) {
  const project = byRepo.get(repo.url.toLowerCase());
  if (!project || !project.data.allowAutomaticMetadata) continue;
  const base = {
    repo: repo.fullName,
    url: repo.url,
    title: project.data.title,
    slug: project.data.slug,
  };
  if (repo.latestCommitAt) events.push({ ...base, date: repo.latestCommitAt, kind: 'push' });
  if (repo.latestRelease)
    events.push({
      ...base,
      date: repo.latestRelease.publishedAt,
      kind: 'release',
      tag: repo.latestRelease.tag,
    });
}
events.sort((a, b) => b.date.localeCompare(a.date));

const crumbs = [{ label: t('nav.home'), href: route('home', lang) }, { label: t('writing.title') }];
---

<BaseLayout
  {lang}
  title={t('writing.title')}
  description={t('writing.lead')}
  current="writing"
  alternates={alternates('writing')}
  jsonLd={[
    {
      '@type': 'Blog',
      name: `${profile.shortName} — ${t('writing.title')}`,
      url: `https://valbergregory.github.io${route('writing', lang)}`,
      inLanguage: en ? 'en' : 'pt-BR',
      author: { '@id': 'https://valbergregory.github.io/#person' },
    },
    breadcrumbJsonLd([
      { name: t('nav.home'), path: route('home', lang) },
      { name: t('writing.title'), path: route('writing', lang) },
    ]),
  ]}
>
  <PageHeader {lang} title={t('writing.title')} lead={t('writing.lead')} {crumbs}>
    <p class="rss">
      <a href="/rss.xml">
        <Icon name="rss" size={16} /> {t('updates.rss')}
      </a>
      <span class="muted">·</span>
      <a href={profile.links.linkedin} rel="me noopener" target="_blank">
        <Icon name="linkedin" size={16} /> LinkedIn{' '}
        <span class="visually-hidden">{t('a11y.newTab')}</span>
      </a>
    </p>
  </PageHeader>

  <div class="container writing-layout">
    <section class="posts" aria-labelledby="posts-title">
      <h2 id="posts-title" class="visually-hidden">
        {t('writing.title')}
      </h2>

      {categoriesUsed.length > 1 && (
        <nav class="cats" aria-label={t('writing.filter')} data-cats>
          <a href={route('writing', lang)} class="tag active" data-cat="">
            {t('writing.all')}
          </a>
          {categoriesUsed.map((c) => (
            <a href={`${route('writing', lang)}?categoria=${c}`} class="tag" data-cat={c}>
              {t(catKey(c))}
            </a>
          ))}
        </nav>
      )}

      {posts.length === 0 ? (
        <p class="muted">{t('updates.none')}</p>
      ) : (
        <ol class="post-list" data-posts>
          {posts.map((post) => (
            <li class="post" data-cat={post.data.category}>
              <div class="post-meta">
                <time datetime={postDateIso(post)}>{formatDate(post.data.date, lang)}</time>
                <span class="tag">{t(catKey(post.data.category))}</span>
              </div>
              <h3>
                <a href={route('writingItem', lang, postSlug(post))}>{post.data.title}</a>
              </h3>
              <p class="summary">{post.data.summary}</p>
              {post.data.project && titleOf(post.data.project) && (
                <p class="small muted">
                  {t('writing.related')}:{' '}
                  <a href={route('researchItem', lang, post.data.project)}>
                    {titleOf(post.data.project)}
                  </a>
                </p>
              )}
            </li>
          ))}
        </ol>
      )}
      <p class="small muted" data-empty hidden>
        {t('research.empty')}
      </p>
    </section>

    <aside class="activity" aria-labelledby="activity-title">
      <h2 id="activity-title">{t('updates.activity')}</h2>
      <p class="small muted">{t('updates.activity.lead')}</p>
      {events.length === 0 ? (
        <p class="muted small">{t('repo.none')}</p>
      ) : (
        <ol class="events">
          {events.slice(0, 10).map((ev) => (
            <li>
              <time datetime={ev.date.slice(0, 10)} class="small muted">
                {formatDate(ev.date, lang, { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <p>
                <strong>{ev.kind === 'release' ? t('updates.release') : t('updates.push')}</strong>
                {ev.tag && <span class="tag">{ev.tag}</span>}
                <br />
                <a href={route('researchItem', lang, ev.slug)}>{ev.title}</a>
              </p>
            </li>
          ))}
        </ol>
      )}
      {github.source !== 'empty' && (
        <p class="small muted">
          {t('repo.fetchedAt')}{' '}
          <time datetime={github.generatedAt}>{formatDate(github.generatedAt, lang)}</time>
          {github.source === 'cache' ? ` — ${t('repo.stale')}` : ''}
        </p>
      )}
    </aside>
  </div>
</BaseLayout>

<style>
  .rss {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
    margin: var(--space-4) 0 0;
  }
  .rss a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    font-weight: 600;
    min-height: 2.25rem;
  }
  .writing-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--space-7);
    padding-block: var(--space-7);
    align-items: start;
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .cats .tag {
    text-decoration: none;
    min-height: 2.25rem;
    padding-inline: 0.8em;
    cursor: pointer;
  }
  .cats .tag.active {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--text-inverse);
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
    max-width: 72ch;
  }
  .post {
    padding-left: var(--space-5);
    border-left: 3px solid var(--teal);
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .post h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  .post h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .post h3 a:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }
  .summary {
    margin-bottom: var(--space-2);
  }
  .activity {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }
  .activity h2 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .events {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    display: grid;
    gap: var(--space-3);
  }
  .events li {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .events p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .events .tag {
    margin-left: var(--space-2);
  }
  @media (max-width: 56rem) {
    .writing-layout {
      grid-template-columns: 1fr;
    }
    .post {
      padding-left: 0;
      border-left: 0;
      border-top: 3px solid var(--teal);
      padding-top: var(--space-3);
    }
  }
</style>

<script>
  // Filtro por categoria sem recarregar (progressivo: os links funcionam sem JS).
  const nav = document.querySelector<HTMLElement>('[data-cats]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-posts] > li'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  function apply(cat: string) {
    let shown = 0;
    for (const li of items) {
      const ok = !cat || li.dataset.cat === cat;
      li.hidden = !ok;
      if (ok) shown += 1;
    }
    if (empty) empty.hidden = shown > 0;
    nav?.querySelectorAll<HTMLElement>('[data-cat]').forEach((a) => {
      a.classList.toggle('active', (a.dataset.cat ?? '') === cat);
      a.setAttribute('aria-current', (a.dataset.cat ?? '') === cat ? 'true' : 'false');
    });
  }
  if (nav) {
    const initial = new URLSearchParams(location.search).get('categoria') ?? '';
    apply(initial);
    nav.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-cat]');
      if (!a) return;
      e.preventDefault();
      const cat = a.dataset.cat ?? '';
      apply(cat);
      history.replaceState(
        null,
        '',
        cat ? `${location.pathname}?categoria=${cat}` : location.pathname,
      );
    });
  }
</script>
