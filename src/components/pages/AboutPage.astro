---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import portrait from '@/assets/valber-portrait.jpg';
import { alternates, route, type Lang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { getProfile, pick } from '@/lib/data';
import { breadcrumbJsonLd, personJsonLd, profilePageJsonLd } from '@/lib/jsonld';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const profile = getProfile();
const en = lang === 'en';

const entry = (await getCollection('pages')).find(
  (e) => e.data.key === 'about' && e.data.lang === lang,
);
if (!entry) throw new Error(`Conteúdo "about" não encontrado para ${lang}`);
const { Content } = await render(entry);

// Bios em outros idiomas (profile.yml › bio): desligadas em 12/09/2026 a pedido do
// titular, até haver materiais e certificações de idiomas. Para reativar, mude para true.
const SHOW_MULTILINGUAL_BIO = false;
const primary = en ? 'en' : 'pt';
const otherBios = SHOW_MULTILINGUAL_BIO
  ? ['pt', 'en', 'fr', 'de', 'it']
      .filter((k) => k !== primary)
      .map((k) => ({ key: k, ...profile.bio[k]! }))
  : [];

const crumbs = [{ label: t('nav.home'), href: route('home', lang) }, { label: t('about.title') }];
---

<BaseLayout
  {lang}
  title={entry.data.title}
  description={entry.data.description}
  current="about"
  alternates={alternates('about')}
  type="profile"
  jsonLd={[
    personJsonLd(lang),
    profilePageJsonLd(lang, route('about', lang)),
    breadcrumbJsonLd([
      { name: t('nav.home'), path: route('home', lang) },
      { name: t('about.title'), path: route('about', lang) },
    ]),
  ]}
>
  <PageHeader {lang} title={entry.data.title} {crumbs} eyebrow={profile.name} />

  <div class="container about-layout">
    <div class="about-main">
      <div class="markdown prose">
        <Content />
      </div>
    </div>
    <aside class="about-side">
      <figure class="about-photo">
        <Image
          src={portrait}
          alt={pick(profile.photo.alt, lang)}
          width={360}
          height={480}
          widths={[280, 360, 560, 720]}
          sizes="(max-width: 56rem) 50vw, 360px"
          format="webp"
        />
      </figure>
      <dl class="definition side-facts">
        <dt>{en ? 'Location' : 'Localização'}</dt>
        <dd>{pick(profile.location, lang)}</dd>
        <dt>{t('contact.email')}</dt>
        <dd>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </dd>
        <dt>{t('contact.profiles')}</dt>
        <dd>
          <ul class="plain">
            <li>
              <a href={profile.links.orcid} rel="me noopener" target="_blank">
                ORCID <span class="visually-hidden">{t('a11y.newTab')}</span>
              </a>
            </li>
            <li>
              <a href={profile.links.lattes} rel="me noopener" target="_blank">
                Lattes <span class="visually-hidden">{t('a11y.newTab')}</span>
              </a>
            </li>
            <li>
              <a href={profile.links.googleScholar} rel="me noopener" target="_blank">
                Google Scholar <span class="visually-hidden">{t('a11y.newTab')}</span>
              </a>
            </li>
            <li>
              <a href={profile.links.github} rel="me noopener" target="_blank">
                GitHub <span class="visually-hidden">{t('a11y.newTab')}</span>
              </a>
            </li>
            <li>
              <a href={profile.links.linkedin} rel="me noopener" target="_blank">
                LinkedIn <span class="visually-hidden">{t('a11y.newTab')}</span>
              </a>
            </li>
          </ul>
        </dd>
      </dl>
    </aside>
  </div>

  {otherBios.length > 0 && (
    <section class="section languages" aria-labelledby="langs-title">
      <div class="container">
        <div class="section-head">
          <h2 id="langs-title">{t('about.languages')}</h2>
        </div>
        <div class="grid grid-2">
          {otherBios.map((bio) => (
            <section class="card bio-card" lang={bio.lang} aria-label={bio.label}>
              <h3>{bio.label}</h3>
              {bio.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
            </section>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--space-7);
    padding-block: var(--space-7);
    align-items: start;
  }
  .markdown :global(h2) {
    font-size: var(--text-xl);
    margin-top: var(--space-6);
  }
  .markdown :global(h2:first-child) {
    margin-top: 0;
  }
  .about-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    position: sticky;
    top: calc(var(--header-h) + var(--space-4));
  }
  .about-photo {
    margin: 0;
  }
  .about-photo :global(img) {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }
  .side-facts {
    grid-template-columns: 1fr;
    row-gap: var(--space-1);
  }
  .side-facts dd {
    margin-bottom: var(--space-3);
    overflow-wrap: anywhere;
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .languages {
    border-top: 1px solid var(--border);
    background: var(--bg-muted);
    padding-top: var(--space-7);
  }
  .bio-card h3 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .bio-card p {
    margin-bottom: var(--space-3);
    color: var(--text);
  }
  @media (max-width: 56rem) {
    .about-layout {
      grid-template-columns: 1fr;
    }
    .about-side {
      position: static;
      order: -1;
    }
    .about-photo {
      width: min(50%, 16rem);
    }
  }
</style>
