---
import Icon from './Icon.astro';
import { NAV_ORDER, ROUTES, route, type Lang, type RouteKey } from '@/i18n/routes';
import { useTranslations, type UiKey } from '@/i18n/ui';

interface Props {
  lang: Lang;
  /** Chave da rota atual (para aria-current e para o seletor de idioma). */
  current: RouteKey;
  /** Caminho equivalente no outro idioma, quando existir. */
  alternatePath?: string;
}

const { lang, current, alternatePath } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'en' ? 'pt-br' : 'en';
const otherPath = alternatePath ?? ROUTES.home[otherLang];
const navKey = (k: RouteKey) => `nav.${k}` as UiKey;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={route('home', lang)} title={t('site.fullName')}>
      <span class="brand-mark" aria-hidden="true">
        VG
      </span>
      <span class="brand-name">Valber Gregory</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <Icon name="menu" class="icon-open" />
      <Icon name="close" class="icon-close" />
      <span
        class="visually-hidden"
        data-label-open={t('nav.open')}
        data-label-close={t('nav.close')}
      >
        {t('nav.open')}
      </span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label={t('nav.label')} data-nav>
      <ul class="nav-list">
        {NAV_ORDER.map((key) => {
          const isCurrent = key === current || (key === 'research' && current === 'researchItem');
          return (
            <li>
              <a
                href={route(key, lang)}
                aria-current={isCurrent ? 'page' : undefined}
                class:list={['nav-link', { active: isCurrent }]}
              >
                {t(navKey(key))}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="nav-tools">
        <a
          class="search-link"
          href={route('search', lang)}
          aria-label={t('nav.search')}
          title={t('nav.search')}
        >
          <Icon name="search" />
        </a>
        <a
          class="lang-switch"
          href={otherPath}
          hreflang={otherLang === 'en' ? 'en' : 'pt-BR'}
          lang={otherLang === 'en' ? 'en' : 'pt-BR'}
          aria-label={t('lang.switchTo')}
          title={t('lang.switchTo')}
        >
          <Icon name="globe" />
          <span>{otherLang === 'en' ? 'EN' : 'PT'}</span>
        </a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label={t('theme.toggle')}>
          <Icon name="sun" class="icon-sun" />
          <Icon name="moon" class="icon-moon" />
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-variation-settings:
      'opsz' 24,
      'wght' 550;
    min-height: 2.75rem;
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 6px;
    background: var(--navy);
    color: var(--text-inverse);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .nav-list {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.7rem;
    border-radius: var(--radius);
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-sm);
    position: relative;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--bg-muted);
  }
  .nav-link.active {
    color: var(--navy);
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.35rem;
    height: 2px;
    background: var(--teal);
    border-radius: 2px;
  }
  .nav-tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-left: var(--space-3);
    border-left: 1px solid var(--border);
  }
  .search-link,
  .lang-switch,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.6rem;
    border-radius: var(--radius);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }
  .search-link:hover,
  .lang-switch:hover,
  .theme-toggle:hover {
    color: var(--text);
    background: var(--bg-muted);
  }
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    cursor: pointer;
  }
  .nav-toggle :global(.icon-close),
  .nav-toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }
  .theme-toggle :global(.icon-moon) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-moon) {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-sun) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.icon-moon) {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.icon-sun) {
      display: none;
    }
  }

  @media (max-width: 60rem) {
    .nav-toggle {
      display: inline-flex;
    }
    .site-nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      padding: var(--space-4) var(--space-5) var(--space-5);
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-md);
    }
    .site-nav.open {
      display: flex;
    }
    .nav-list {
      flex-direction: column;
      gap: 0;
    }
    .nav-link {
      width: 100%;
      min-height: 3rem;
      padding: 0 var(--space-3);
    }
    .nav-link.active::after {
      left: var(--space-3);
      right: auto;
      width: 2.5rem;
    }
    .nav-tools {
      border-left: 0;
      padding-left: 0;
      padding-top: var(--space-3);
      border-top: 1px solid var(--border);
    }
  }
</style>

<script>
  // Menu móvel acessível: alterna aria-expanded, fecha com Escape e ao clicar fora.
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const label = toggle?.querySelector<HTMLElement>('.visually-hidden');

  function setOpen(open: boolean) {
    if (!toggle || !nav || !label) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
    label.textContent = open ? label.dataset.labelClose! : label.dataset.labelOpen!;
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!nav || !toggle) return;
    const target = e.target as Node;
    if (nav.classList.contains('open') && !nav.contains(target) && !toggle.contains(target)) {
      setOpen(false);
    }
  });

  // Tema claro/escuro com persistência (a preferência inicial é aplicada em BaseLayout).
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const currentDark = root.dataset.theme ? root.dataset.theme === 'dark' : systemDark;
    const next = currentDark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* armazenamento indisponível: o tema vale só para esta página */
    }
  });
</script>
