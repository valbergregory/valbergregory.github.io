---
/** Cartão de uma publicação da seção Conteúdos (capa, título, subtítulo, resumo, temas). */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Lang } from '@/i18n/routes';
import { useTranslations, type UiKey } from '@/i18n/ui';
import { formatDate } from '@/lib/data';
import { contentPath, dateIso, readingTime, type Content, type Series } from '@/lib/contents';

interface Props {
  content: Content;
  lang: Lang;
  series?: Series;
  /** Mostra o nome da série no cartão (listagens gerais). */
  showSeries?: boolean;
  headingLevel?: 'h2' | 'h3';
  /** Índice para priorizar o carregamento das primeiras capas. */
  index?: number;
  /** Layout horizontal, com capa pequena à esquerda (listagens longas). */
  compact?: boolean;
}
const {
  content,
  lang,
  series,
  showSeries = false,
  headingLevel = 'h3',
  index = 99,
  compact = false,
} = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel;
const d = content.data;
const href = contentPath(content, series);
const typeLabel = t(`contentType.${d.type}` as UiKey);
const minutes = readingTime(content.body);
const eager = index < 3;
---

<article
  class:list={['card content-card', { compact }, series ? `palette-${series.data.palette}` : '']}
  data-series={d.series ?? ''}
  data-type={d.type}
  data-areas={d.areas.join(' ')}
  data-tags={d.tags.map((x) => x.toLowerCase()).join('|')}
>
  {d.cover && (
    <a class="cover" href={href} tabindex="-1" aria-hidden="true">
      <Image
        src={d.cover}
        alt=""
        width={560}
        height={700}
        widths={compact ? [200, 320, 480] : [320, 480, 640]}
        sizes={
          compact
            ? '(max-width: 30rem) 90vw, 200px'
            : '(max-width: 40rem) 90vw, (max-width: 64rem) 45vw, 360px'
        }
        format="webp"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </a>
  )}
  <div class="card-body">
    <p class="card-top small">
      {d.series && d.order && (
        <span class="eyebrow">
          {showSeries && series ? `${series.data.title} · ` : ''}
          {lang === 'en' ? `Part ${d.order}` : `Parte ${d.order}`}
        </span>
      )}
      {!d.series && <span class="eyebrow">{typeLabel}</span>}
      <time datetime={dateIso(d.date)} class="muted">
        {formatDate(d.date, lang, { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
    </p>
    <Heading>
      <a href={href}>{d.title}</a>
    </Heading>
    {d.subtitle && <p class="subtitle">{d.subtitle}</p>}
    <p class="summary">{d.summary}</p>
    <p class="card-actions">
      <a class="button secondary" href={href}>
        {t('contents.readMore')} <Icon name="arrow" size={16} />
      </a>
      <span class="small muted">
        <Icon name="clock" size={14} /> {minutes} {t('contents.readingTime')}
      </span>
    </p>
    {d.tags.length > 0 && (
      <ul class="chip-list" aria-label={t('contents.tags')}>
        {d.tags.slice(0, 4).map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .content-card {
    padding: 0;
    overflow: hidden;
  }
  .cover {
    display: block;
    aspect-ratio: 4 / 5;
    background: var(--bg-muted);
    border-bottom: 1px solid var(--border);
  }
  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .card-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0;
  }
  .eyebrow {
    margin: 0;
    color: var(--teal-strong);
  }
  .palette-ocean .eyebrow {
    color: var(--navy);
  }
  .content-card h2,
  .content-card h3 {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }
  .subtitle {
    margin: 0;
    font-weight: 600;
    color: var(--text-muted);
  }
  .summary {
    margin: 0;
    font-size: var(--text-sm);
  }
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-2) 0 0;
  }
  .card-actions .button {
    min-height: 2.5rem;
    padding-block: 0.4rem;
  }
  .card-actions .small {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .compact {
    flex-direction: row;
    align-items: flex-start;
  }
  .compact .cover {
    flex: 0 0 200px;
    aspect-ratio: 4 / 5;
    border-bottom: 0;
    border-right: 1px solid var(--border);
    border-bottom-right-radius: var(--radius-lg);
  }
  .compact .card-body {
    flex: 1;
    min-width: 0;
  }
  .compact h2,
  .compact h3 {
    font-size: var(--text-md);
  }
  @media (max-width: 30rem) {
    .compact {
      flex-direction: column;
    }
    .compact .cover {
      flex-basis: auto;
      width: 100%;
      border-right: 0;
      border-bottom: 1px solid var(--border);
      border-bottom-right-radius: 0;
    }
  }
</style>
