{
  "name": "valbergregory.github.io",
  "version": "2.0.0",
  "private": true,
  "description": "Página pessoal acadêmica de Valber Gregory Barbosa Costa Bezerra Santos — Astro, GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/generate-cv.mjs && astro dev",
    "sync:github": "node scripts/sync-github.mjs",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "build": "node scripts/generate-cv.mjs && astro build && pagefind --site dist",
    "check:links": "node scripts/check-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "og:generate": "node scripts/generate-og.mjs",
    "preview": "astro preview",
    "format": "prettier --write .",
    "cv:generate": "node scripts/generate-cv.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "astro": "^7.3.2",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  }
}
